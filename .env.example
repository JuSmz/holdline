# Holdline — environment variables (names only; never commit real values).
# Copy to .env and fill in. Secrets must be at least 32 characters.
# An integration is enabled only when ALL of its variables are set.

# --- App ---------------------------------------------------------------
APP_URL=                      # optional; falls back to RENDER_EXTERNAL_URL on Render
APP_INSTANCE_ID=dj            # prefix for every PayPal-facing ID: p1 (prod) | dj (local) | t-* (tests)
SESSION_SECRET=               # >=32 chars; HKDF root for signed tokens
ADMIN_TOKEN=                  # >=32 chars; owner login
CRON_SECRET=                  # >=32 chars; Bearer token for /api/jobs/tick
DATABASE_URL=postgres://postgres@localhost:55433/holdline        # scripts/local-db.sh
DATABASE_URL_TEST=postgres://postgres@localhost:55433/holdline_test
OWNER_PHONE=                  # optional, E.164; routes the owner's own calls to the main workspace

# --- PayPal (sandbox only) ----------------------------------------------
PAYPAL_ENV=sandbox            # anything else refuses to start
PAYPAL_MODE=live              # live | mock (mock is refused on Render)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_BUSINESS_EMAIL=        # the US sandbox business account (invoicer)
SANDBOX_BUYERS=               # JSON: [{"email":"...","password":"..."}] — US sandbox buyers shown to judges
TECH_PAYOUT_EMAIL_MAYA=       # US sandbox personal account
TECH_PAYOUT_EMAIL_LUIS=       # US sandbox personal account

# --- Vapi ---------------------------------------------------------------
VAPI_PRIVATE_KEY=
VAPI_ASSISTANT_ID=            # printed by scripts/vapi-setup.ts
VAPI_WEBHOOK_SECRET=          # >=32 chars; Bearer credential for Vapi -> our webhooks
VAPI_PHONE_NUMBER=            # display only
VAPI_LLM_PROVIDER=google
VAPI_LLM_MODEL=
VAPI_LLM_MAX_TOKENS=1000
VAPI_LLM_TEMPERATURE=1.0
VAPI_MAX_CALL_SECONDS=480
DEMO_DAILY_VOICE_MINUTES=
DEMO_DAILY_PHONE_MINUTES=

# --- Gemini -------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=
GEMINI_SUMMARY_MODEL=
GEMINI_DAILY_BUDGET_CENTS=

# --- Email (Resend) ------------------------------------------------------
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM=                   # e.g. Holdline <bookings@mail.example.com>

# --- Flags ----------------------------------------------------------------
LAB_ENABLED=false
